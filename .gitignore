# Godot 4+ specific ignores
.godot/
*.uid
godot

# MCP addons (local dev tools)
addons/godot_mcp/

# Godot-specific ignores
*.translation

# Imported textures and samples
.import/

# Mod art ships as raw files a mod decodes itself (see ModAPI.load_texture),
# so the import metadata Godot generates for art inside mods/ is never part of
# a mod - and ModPackage strips it from every packed zip anyway.
mods/**/*.import

# Build and export
/build/
/dist/
/export/
*.exe
*.x86_64
*.pck

# OS/IDE specific
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# VSCode
.vscode/

# JetBrains
.idea/

# Backup files
*.bak
*.backup

# Harness renders
tmp_preview/

# Log files
*.log
